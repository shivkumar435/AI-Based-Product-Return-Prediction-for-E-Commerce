# Production backend API base URL for Vercel deployment
# Both VITE_API_BASE_URL and VITE_API_URL are supported.
# Example: https://ai-based-product-return-prediction.onrender.com/api
# (If you provide the domain without /api, e.g. https://...onrender.com, it will be automatically appended)
# Leave empty for local development to use Vite's proxy (/api)
VITE_API_BASE_URL=https://your-backend-api-url.onrender.com/api
VITE_API_URL=https://your-backend-api-url.onrender.com/api
