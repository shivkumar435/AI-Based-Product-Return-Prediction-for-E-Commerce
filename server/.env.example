# MongoDB connection (use your MongoDB Atlas connection string in production)
MONGO_URI=mongodb://127.0.0.1:27017/return-prediction

# JWT secret key for signing tokens (change this in production)
JWT_SECRET=change-this-secret-before-production

# Server Port
PORT=5000

# URL of the Python Flask ML Service
ML_API_URL=http://localhost:5001

# Frontend URL (e.g. your Vercel deployment URL)
CLIENT_URL=http://localhost:5173

# Allowed CORS origins (comma-separated, include your Vercel frontend domain)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://ai-based-product-return-prediction.vercel.app

NODE_ENV=development
